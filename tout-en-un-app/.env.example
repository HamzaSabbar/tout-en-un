DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Optionnel, utilisé pour construire les liens envoyés par email (ex. réinitialisation de mot de passe).
APP_URL="http://localhost:3000"

# Optionnel, pour `npm run seed:admin` (compte admin d'un environnement de
# développement). Aucun mot de passe n'est codé en dur : sans ADMIN_MOT_DE_PASSE,
# le script en génère un et l'affiche une seule fois.
ADMIN_EMAIL="admin@dev.local"
ADMIN_MOT_DE_PASSE=""
ADMIN_TELEPHONE="0600000000"

# Optionnel, Supabase Storage pour le téléversement de documents PDF (lot 1).
#
# Renseignées, elles sont utilisées. Absentes, le stockage bascule sur un
# répertoire local `.stockage-local/`, réservé au développement et aux tests : il
# rend le téléversement du back-office et la lecture d'un PDF par l'élève
# réellement exécutables sans bucket provisionné. Absentes **en production**,
# src/lib/storage/storage.ts échoue clairement à l'appel plutôt que d'écrire sur
# un disque éphémère.
SUPABASE_STORAGE_URL="https://xxxx.supabase.co"
SUPABASE_STORAGE_KEY="service-role-key"
SUPABASE_STORAGE_BUCKET="contenu-pedagogique"

# Dérogation, à ne poser que sciemment. `next start` fixe NODE_ENV=production, y
# compris pour la recette de bout en bout qui a besoin du stockage local : cette
# variable est la seule façon de l'ouvrir dans ce mode. playwright.config.ts la
# pose pour sa propre exécution. Elle n'a rien à faire dans un environnement réel.
STOCKAGE_LOCAL_AUTORISE=""
