DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Optionnel, utilisé pour construire les liens envoyés par email (ex. réinitialisation de mot de passe).
APP_URL="http://localhost:3000"

# Optionnel, pour `npm run seed:admin` (compte admin d'un environnement de
# développement). Aucun mot de passe n'est codé en dur : sans ADMIN_MOT_DE_PASSE,
# le script en génère un et l'affiche une seule fois.
ADMIN_EMAIL="admin@dev.local"
ADMIN_MOT_DE_PASSE=""
ADMIN_TELEPHONE="0600000000"

# Optionnel, Supabase Storage pour le téléversement de documents PDF (lot 1).
# Tant qu'absentes, src/lib/storage/storage.ts échoue clairement à l'appel.
SUPABASE_STORAGE_URL="https://xxxx.supabase.co"
SUPABASE_STORAGE_KEY="service-role-key"
SUPABASE_STORAGE_BUCKET="contenu-pedagogique"
