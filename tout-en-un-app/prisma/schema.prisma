generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  eleve
  admin
  professeur
  support
  commercial

  @@map("role")
}

enum Statut {
  brouillon
  publie

  @@map("statut")
}

enum TypeDocument {
  cours_pdf
  resume_pdf
  correction_pdf
  sujet_pdf
  support_live
  // Image intégrée au contenu riche d'un exercice. Elle passe par la même table
  // `fichier` que les PDF, donc par une URL signée : le contenu riche ne stocke
  // qu'un identifiant, jamais une URL (invariant 3).
  image_exercice

  @@map("type_document")
}

// MVP limité à qcm et vrai_faux (roadmap, lot 6, hors périmètre §19) :
// reponse_courte est modélisée pour ne pas migrer le schéma plus tard, mais
// n'est jamais proposée par le formulaire d'admin — elle imposerait une
// correction manuelle ou une normalisation de texte fragile.
enum TypeQuestionTest {
  qcm
  vrai_faux
  reponse_courte

  @@map("type_question_test")
}

// Remplace l'ancienne échelle de difficulté 1..5 (facile/moyen/difficile) : le
// professeur classe un exercice par son rôle pédagogique plutôt que par son
// niveau, et l'élève les parcourt dans cet ordre (compréhension d'abord,
// approfondissement en dernier). L'ordre de déclaration fixe l'ordre de tri
// PostgreSQL natif d'un enum, exploité par `orderBy: { categorie: "asc" }`
// dans `parcours-eleve/service.ts` pour regrouper l'affichage sans requête ni
// tri supplémentaire.
enum CategorieExercice {
  comprehension
  type_bac
  approfondissement

  @@map("categorie_exercice")
}

enum RessourceApprentissage {
  video
  exercice
  extrait
  examen
  test

  @@map("ressource_apprentissage")
}

// Architecture 5.5 énumère vue, terminee, reussi, a_refaire et test_valide.
// `aide_ouverte` et `correction_vue` sont ajoutées au lot 4 : la section 9 exige
// de savoir quelle proportion d'élèves ouvre l'aide d'un exercice, ce qu'aucune
// des valeurs d'origine ne permet d'exprimer. Architecture 5.5 est mise à jour
// dans le même commit.
enum ActionApprentissage {
  vue
  terminee
  aide_ouverte
  correction_vue
  reussi
  a_refaire
  test_valide

  @@map("action_apprentissage")
}

enum StatutAbonnement {
  en_attente
  actif
  expire
  annule

  @@map("statut_abonnement")
}

enum StatutPaiement {
  en_attente
  paye

  @@map("statut_paiement")
}

enum StatutDemande {
  en_attente
  traitee
  refusee

  @@map("statut_demande")
}

enum SessionExamen {
  normale
  rattrapage

  @@map("session_examen")
}

model Utilisateur {
  id                 BigInt    @id @default(autoincrement())
  nom                String
  prenom             String
  email              String    @unique
  telephone          String
  ville              String?
  mot_de_passe_hash  String
  role               Role      @default(eleve)
  filiere_id         BigInt?
  actif              Boolean   @default(true)
  derniere_connexion DateTime?
  cree_le            DateTime  @default(now())

  filiere                 Filiere?                 @relation(fields: [filiere_id], references: [id])
  sessions                SessionUtilisateur[]
  jetons_reinitialisation JetonReinitialisation[]
  cours_enseignes         Cours[]
  fichiers_televerses     Fichier[]
  abonnements             Abonnement[]
  demandes_matiere        DemandeMatiere[]         @relation("demandeur")
  demandes_traitees       DemandeMatiere[]         @relation("traitant")
  actions_admin           JournalAdmin[]
  evenements              EvenementApprentissage[]
  tentatives_test         TentativeTest[]
  notes_carnet            CarnetErreur[]

  @@index([filiere_id])
  @@map("utilisateur")
}

model JetonReinitialisation {
  id             BigInt    @id @default(autoincrement())
  utilisateur_id BigInt
  jeton_hash     String    @unique
  expire_le      DateTime
  utilise_le     DateTime?
  cree_le        DateTime  @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id])
  @@map("jeton_reinitialisation")
}

model SessionUtilisateur {
  id             BigInt   @id @default(autoincrement())
  utilisateur_id BigInt
  jeton_hash     String   @unique
  appareil       String?
  ip             String?
  expire_le      DateTime
  revoquee       Boolean  @default(false)
  cree_le        DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id])
  @@map("session_utilisateur")
}

// `cree_le` est nullable sur les tables de contenu, contrairement aux autres
// tables. Les lignes antérieures à la migration n'ont pas de date connue : leur
// donner l'heure de la migration affirmerait une date fausse, ce qui est
// précisément ce qui a rendu l'audit des données de test laborieux. NULL veut
// dire « date inconnue ». La colonne pourra passer en NOT NULL une fois ces
// lignes traitées.
model Filiere {
  id      BigInt    @id @default(autoincrement())
  code    String    @unique
  libelle String
  ordre   Int       @default(0)
  actif   Boolean   @default(true)
  cree_le DateTime? @default(now())

  matieres          FiliereMatiere[]
  eleves            Utilisateur[]
  examens_nationaux ExamenNational[]

  @@map("filiere")
}

model Matiere {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique
  libelle     String
  description String?
  icone       String?
  couleur     String?
  statut      Statut    @default(brouillon)
  ordre       Int       @default(0)
  cree_le     DateTime? @default(now())
  supprime_le DateTime?

  filieres            FiliereMatiere[]
  parties             Partie[]
  chapitres           Chapitre[]
  documents           Document[]
  abonnements_matiere AbonnementMatiere[]
  demandes            DemandeMatiere[]
  extraits_nationaux  ExtraitNational[]
  examens_nationaux   ExamenNational[]

  @@map("matiere")
}

// Niveau optionnel entre matière et chapitre (ex. Physique-Chimie : Physique /
// Chimie). `chapitre.matiere_id` reste inchangé, renseigné qu'une partie
// existe ou non : `partie_id` est un tag additionnel, jamais un remplacement
// de la relation à la matière. `cree_le` non nullable : table neuve, aucune
// ligne antérieure à dater.
model Partie {
  id          BigInt    @id @default(autoincrement())
  matiere_id  BigInt
  libelle     String
  description String?
  icone       String?
  ordre       Int       @default(0)
  statut      Statut    @default(brouillon)
  cree_le     DateTime  @default(now())
  supprime_le DateTime?

  matiere   Matiere    @relation(fields: [matiere_id], references: [id])
  chapitres Chapitre[]

  @@index([matiere_id, statut, ordre])
  @@map("partie")
}

model FiliereMatiere {
  id         BigInt @id @default(autoincrement())
  filiere_id BigInt
  matiere_id BigInt

  filiere Filiere @relation(fields: [filiere_id], references: [id])
  matiere Matiere @relation(fields: [matiere_id], references: [id])

  @@unique([filiere_id, matiere_id])
  @@map("filiere_matiere")
}

model Chapitre {
  id          BigInt    @id @default(autoincrement())
  matiere_id  BigInt
  partie_id   BigInt?
  libelle     String
  description String?
  icone       String?
  ordre       Int       @default(0)
  statut      Statut    @default(brouillon)
  cree_le     DateTime? @default(now())
  supprime_le DateTime?

  matiere            Matiere           @relation(fields: [matiere_id], references: [id])
  partie             Partie?           @relation(fields: [partie_id], references: [id])
  cours              Cours[]
  documents          Document[]
  extraits_nationaux ExtraitNational[]

  @@index([matiere_id, statut, ordre])
  @@index([partie_id, statut, ordre])
  @@map("chapitre")
}

model Cours {
  id            BigInt    @id @default(autoincrement())
  chapitre_id   BigInt
  titre         String
  description   String?
  ordre         Int       @default(0)
  statut        Statut    @default(brouillon)
  professeur_id BigInt?
  publie_le     DateTime?
  cree_le       DateTime? @default(now())
  supprime_le   DateTime?

  chapitre           Chapitre          @relation(fields: [chapitre_id], references: [id])
  professeur         Utilisateur?      @relation(fields: [professeur_id], references: [id])
  videos             Video[]
  documents          Document[]
  exercices          Exercice[]
  extraits_nationaux ExtraitNational[]
  test               Test?

  @@index([chapitre_id, statut, ordre])
  @@map("cours")
}

model Video {
  id             BigInt    @id @default(autoincrement())
  cours_id       BigInt
  titre          String
  description    String?
  duree_secondes Int?
  fournisseur    String
  video_ref      String
  ordre          Int       @default(0)
  statut         Statut    @default(brouillon)
  cree_le        DateTime? @default(now())
  supprime_le    DateTime?

  cours Cours @relation(fields: [cours_id], references: [id])

  @@index([cours_id, statut, ordre])
  @@map("video")
}

model Fichier {
  id            BigInt    @id @default(autoincrement())
  nom           String
  cle_stockage  String    @unique
  type_mime     String
  taille        Int
  televerse_par BigInt?
  cree_le       DateTime  @default(now())
  supprime_le   DateTime?

  televerseur Utilisateur? @relation(fields: [televerse_par], references: [id])
  documents   Document[]

  @@map("fichier")
}

model Document {
  id          BigInt       @id @default(autoincrement())
  type        TypeDocument
  titre       String
  matiere_id  BigInt?
  chapitre_id BigInt?
  cours_id    BigInt?
  fichier_id  BigInt
  statut      Statut       @default(brouillon)
  supprime_le DateTime?

  matiere  Matiere?  @relation(fields: [matiere_id], references: [id])
  chapitre Chapitre? @relation(fields: [chapitre_id], references: [id])
  cours    Cours?    @relation(fields: [cours_id], references: [id])
  fichier  Fichier   @relation(fields: [fichier_id], references: [id])

  extrait_sujet      ExtraitNational? @relation("ExtraitSujetDocument")
  extrait_correction ExtraitNational? @relation("ExtraitCorrectionDocument")
  examen_sujet       ExamenNational?  @relation("ExamenSujetDocument")
  examen_correction  ExamenNational?  @relation("ExamenCorrectionDocument")

  @@map("document")
}

// Extrait d'un examen national rattaché à un cours précis (architecture 5.3).
// `enonce` est un court descriptif texte, pas du contenu riche : la matière
// mathématique vit dans le PDF `sujet_document_id`, que l'élève ouvre — pas de
// raison d'alourdir le budget JS élève avec le rendu KaTeX pour ce champ.
//
// `sujet_document_id`/`correction_document_id` pointent vers des lignes
// `document` dont `matiere_id` est renseigné (clé de stockage lisible) mais
// `chapitre_id`/`cours_id` restent `null` : sinon ces PDF fuiteraient dans les
// listes génériques de documents d'un cours. La visibilité ne dépend donc
// jamais de `document.statut` (laissé à `brouillon`), uniquement du statut de
// cette table — un seul état à publier, pas deux à synchroniser. `@unique` sur
// les deux colonnes : un PDF n'appartient qu'à un seul extrait.
//
// `cree_le` non nullable : table neuve, aucune ligne antérieure à dater.
// `difficulte` bornée à 1..5 par une contrainte CHECK ajoutée à la main dans
// la migration, comme `exercice.difficulte`.
model ExtraitNational {
  id                     BigInt        @id @default(autoincrement())
  matiere_id             BigInt
  chapitre_id            BigInt
  cours_id               BigInt
  annee                  Int
  session                SessionExamen
  enonce                 String
  sujet_document_id      BigInt?       @unique
  correction_document_id BigInt?       @unique
  correction_video_ref   String?
  duree_recommandee      Int?
  difficulte             Int           @default(3)
  ordre                  Int           @default(0)
  statut                 Statut        @default(brouillon)
  cree_le                DateTime      @default(now())
  supprime_le            DateTime?

  matiere             Matiere   @relation(fields: [matiere_id], references: [id])
  chapitre            Chapitre  @relation(fields: [chapitre_id], references: [id])
  cours               Cours     @relation(fields: [cours_id], references: [id])
  sujet_document      Document? @relation("ExtraitSujetDocument", fields: [sujet_document_id], references: [id])
  correction_document Document? @relation("ExtraitCorrectionDocument", fields: [correction_document_id], references: [id])

  @@index([cours_id, statut, ordre])
  @@map("extrait_national")
}

// Examen complet, consultable par année et par filière (architecture 5.3), pas
// rattaché à un chapitre/cours contrairement à `extrait_national`. Unicité
// `(matiere_id, annee, session)` exigée par architecture 5.9 et le critère de
// sortie du lot 5.
model ExamenNational {
  id                     BigInt        @id @default(autoincrement())
  matiere_id             BigInt
  filiere_id             BigInt
  annee                  Int
  session                SessionExamen
  sujet_document_id      BigInt?       @unique
  correction_document_id BigInt?       @unique
  correction_video_ref   String?
  statut                 Statut        @default(brouillon)
  cree_le                DateTime      @default(now())
  supprime_le            DateTime?

  matiere             Matiere   @relation(fields: [matiere_id], references: [id])
  filiere             Filiere   @relation(fields: [filiere_id], references: [id])
  sujet_document      Document? @relation("ExamenSujetDocument", fields: [sujet_document_id], references: [id])
  correction_document Document? @relation("ExamenCorrectionDocument", fields: [correction_document_id], references: [id])

  @@unique([matiere_id, annee, session])
  @@index([matiere_id, filiere_id, annee])
  @@map("examen_national")
}

// Un exercice n'est pas un PDF : énoncé, aide et correction sont du contenu riche
// structuré (architecture 9). Le JSON suit un jeu fermé de types de nœuds validé
// par Zod à l'écriture, jamais de HTML brut.
//
// `cree_le` est non nullable, contrairement aux autres tables de contenu : leur
// nullabilité vient des lignes antérieures à la migration, dont la date est
// inconnue. Cette table est neuve, elle n'en a aucune.
model Exercice {
  id                   BigInt            @id @default(autoincrement())
  cours_id             BigInt
  titre                String
  enonce               Json
  aide                 Json?
  correction_texte     Json?
  correction_video_ref String?
  categorie            CategorieExercice @default(comprehension)
  ordre                Int               @default(0)
  statut               Statut            @default(brouillon)
  cree_le              DateTime          @default(now())
  supprime_le          DateTime?

  cours        Cours          @relation(fields: [cours_id], references: [id])
  notes_carnet CarnetErreur[]

  @@index([cours_id, statut, ordre])
  @@map("exercice")
}

// Une note personnelle par élève et par exercice : le professeur ne la voit
// jamais, elle n'est pas du contenu pédagogique. `@@unique` porte la règle
// « une seule note par élève et par exercice » : répondre « non » une
// seconde fois édite la note existante au lieu d'en créer une seconde.
// Suppression physique assumée (pas de `supprime_le`) : donnée personnelle
// et jetable de l'élève, pas du contenu du professeur — contrairement à
// l'invariant « pas de suppression physique » qui vise ce dernier.
model CarnetErreur {
  id             BigInt   @id @default(autoincrement())
  utilisateur_id BigInt
  exercice_id    BigInt
  erreur         String?
  retenu         String?
  cree_le        DateTime @default(now())
  modifie_le     DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])
  exercice    Exercice    @relation(fields: [exercice_id], references: [id])

  @@unique([utilisateur_id, exercice_id])
  @@index([utilisateur_id, cree_le])
  @@map("carnet_erreur")
}

// Un test par cours au MVP (architecture 5.3, hors périmètre §19 : plusieurs
// tests par cours n'est pas construit). `cours_id` unique porte cette règle
// au niveau base, pas seulement applicative.
model Test {
  id               BigInt    @id @default(autoincrement())
  cours_id         BigInt    @unique
  titre            String
  consigne         String?
  seuil_validation Int       @default(50)
  duree_minutes    Int
  statut           Statut    @default(brouillon)
  cree_le          DateTime  @default(now())
  supprime_le      DateTime?

  cours      Cours           @relation(fields: [cours_id], references: [id])
  questions  QuestionTest[]
  tentatives TentativeTest[]

  @@map("test")
}

// Pas de `statut` propre à la question : seul le test publie ou dépublie,
// une question ajoutée à un test déjà publié est visible immédiatement.
// `enonce`/`explication` réutilisent le même contenu riche que
// `exercice.enonce` (`documentRicheSchema`, `src/modules/exercice/document-riche.ts`).
model QuestionTest {
  id               BigInt           @id @default(autoincrement())
  test_id          BigInt
  type             TypeQuestionTest @default(qcm)
  enonce           Json
  image_fichier_id BigInt?
  points           Int              @default(1)
  explication      Json?
  ordre            Int              @default(0)
  cree_le          DateTime         @default(now())
  supprime_le      DateTime?

  test     Test               @relation(fields: [test_id], references: [id])
  options  OptionReponse[]
  reponses ReponseTentative[]

  @@index([test_id, ordre])
  @@map("question_test")
}

model OptionReponse {
  id               BigInt  @id @default(autoincrement())
  question_test_id BigInt
  libelle          String
  est_correcte     Boolean @default(false)
  ordre            Int     @default(0)

  question QuestionTest @relation(fields: [question_test_id], references: [id])

  @@index([question_test_id, ordre])
  @@map("option_reponse")
}

// Retentatives autorisées, sans limite : comme le reste du journal
// d'apprentissage, la plus récente fait foi pour « dernière note ». Une
// tentative `termine_le: null` est reprise, jamais dupliquée (critère de
// sortie du lot 6 : une coupure réseau ne fait rien perdre).
model TentativeTest {
  id             BigInt    @id @default(autoincrement())
  test_id        BigInt
  utilisateur_id BigInt
  score          Int?
  score_max      Int?
  valide         Boolean?
  demarre_le     DateTime  @default(now())
  termine_le     DateTime?

  test        Test               @relation(fields: [test_id], references: [id])
  utilisateur Utilisateur        @relation(fields: [utilisateur_id], references: [id])
  reponses    ReponseTentative[]

  @@index([test_id, utilisateur_id])
  @@map("tentative_test")
}

// `option_id` reste nullable tant que la question n'a pas encore de réponse
// enregistrée. `correcte` reste `null` jusqu'à la soumission : rien n'est
// corrigé avant, la correction se fait entièrement au moment de
// `soumettreTentative` (invariant 4, aucune bonne réponse avant soumission).
model ReponseTentative {
  id               BigInt   @id @default(autoincrement())
  tentative_id     BigInt
  question_test_id BigInt
  option_id        BigInt?
  correcte         Boolean?
  cree_le          DateTime @default(now())

  tentative TentativeTest @relation(fields: [tentative_id], references: [id])
  question  QuestionTest  @relation(fields: [question_test_id], references: [id])

  @@unique([tentative_id, question_test_id])
  @@map("reponse_tentative")
}

// Journal immuable de l'activité d'apprentissage (architecture 5.5). Créé au
// lot 4 parce que son critère de sortie en dépend, alors que la roadmap le liste
// sous le lot 7. Le lot 4 y écrit des faits ; le lot 7 en dérivera les agrégats
// de progression. Aucun pourcentage n'est calculé ici.
//
// `cree_le` est non nullable : table neuve, aucune ligne antérieure à dater.
model EvenementApprentissage {
  id             BigInt                 @id @default(autoincrement())
  utilisateur_id BigInt
  matiere_id     BigInt
  chapitre_id    BigInt?
  cours_id       BigInt?
  ressource_type RessourceApprentissage
  ressource_id   BigInt
  action         ActionApprentissage
  valeur         Decimal?               @db.Decimal(6, 2)
  duree_secondes Int?
  cree_le        DateTime               @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id, cree_le])
  @@index([ressource_type, ressource_id, action])
  @@map("evenement_apprentissage")
}

model Offre {
  id          BigInt    @id @default(autoincrement())
  libelle     String
  description String?
  duree_jours Int
  nb_matieres Int
  prix        Decimal   @db.Decimal(10, 2)
  actif       Boolean   @default(true)
  cree_le     DateTime? @default(now())
  supprime_le DateTime?

  abonnements Abonnement[]

  @@map("offre")
}

model Abonnement {
  id                 BigInt           @id @default(autoincrement())
  utilisateur_id     BigInt
  offre_id           BigInt
  date_debut         DateTime?
  date_fin           DateTime?
  statut             StatutAbonnement @default(en_attente)
  montant            Decimal          @db.Decimal(10, 2)
  paiement_statut    StatutPaiement   @default(en_attente)
  reference_paiement String?
  note_admin         String?
  cree_le            DateTime         @default(now())

  utilisateur Utilisateur         @relation(fields: [utilisateur_id], references: [id])
  offre       Offre               @relation(fields: [offre_id], references: [id])
  matieres    AbonnementMatiere[]
  demandes    DemandeMatiere[]

  @@index([utilisateur_id, statut])
  @@map("abonnement")
}

// L'accès se joue ici, matière par matière, jamais au niveau de l'abonnement.
// Volontairement sans utilisateur_id ni statut dupliqués (architecture 5.10) :
// une copie du statut pourrait se désynchroniser d'une annulation d'abonnement.
model AbonnementMatiere {
  id              BigInt   @id @default(autoincrement())
  abonnement_id   BigInt
  matiere_id      BigInt
  date_activation DateTime @default(now())
  date_expiration DateTime

  abonnement Abonnement @relation(fields: [abonnement_id], references: [id])
  matiere    Matiere    @relation(fields: [matiere_id], references: [id])

  @@unique([abonnement_id, matiere_id])
  @@index([matiere_id, date_expiration])
  @@map("abonnement_matiere")
}

model DemandeMatiere {
  id             BigInt        @id @default(autoincrement())
  utilisateur_id BigInt
  matiere_id     BigInt
  abonnement_id  BigInt
  statut         StatutDemande @default(en_attente)
  message        String?
  cree_le        DateTime      @default(now())
  traite_le      DateTime?
  traite_par     BigInt?

  utilisateur Utilisateur  @relation("demandeur", fields: [utilisateur_id], references: [id])
  matiere     Matiere      @relation(fields: [matiere_id], references: [id])
  abonnement  Abonnement   @relation(fields: [abonnement_id], references: [id])
  traitant    Utilisateur? @relation("traitant", fields: [traite_par], references: [id])

  @@index([statut, cree_le])
  @@map("demande_matiere")
}

model JournalAdmin {
  id             BigInt   @id @default(autoincrement())
  utilisateur_id BigInt
  action         String
  entite         String
  entite_id      BigInt
  avant          Json?
  apres          Json?
  cree_le        DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([entite, entite_id])
  @@index([utilisateur_id, cree_le])
  @@map("journal_admin")
}

// Une seule ligne vivante (id fixe 1, gérée par upsert côté service) : la
// date du prochain national, affichée en compte à rebours sur l'accueil élève
// et modifiable par l'admin. Pas d'historique nécessaire, l'admin la remplace
// chaque année.
model DateExamenNational {
  id         BigInt   @id @default(autoincrement())
  date       DateTime
  libelle    String
  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  @@map("date_examen_national")
}
