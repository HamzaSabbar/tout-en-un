# Base dédiée aux tests de bout en bout. Copie ce fichier vers .env.test.
#
# Les tests créent et suppriment des comptes, des filières et du contenu. Ils
# refusent de tourner sur une base distante : e2e/support/base-test.ts vérifie
# que l'hôte est local, sinon la suite s'arrête avant le premier scénario.
#
# Démarrer une base jetable, équivalente au service postgres du workflow CI :
#   docker run --rm -d --name tout-en-un-test -p 5432:5432 \
#     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=postgres postgres:16
#   npx prisma migrate deploy
#
# Si un PostgreSQL local occupe déjà le port 5432, publie la base de test sur un
# autre port (par exemple -p 5433:5432) et ajuste les URL ci-dessous.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

APP_URL="http://localhost:3000"
